{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gaokao_math_library/schemas/paper.schema.json",
  "title": "Paper Metadata",
  "type": "object",
  "required": ["paper", "items"],
  "additionalProperties": false,
  "properties": {
    "paper": {
      "type": "object",
      "required": [
        "id",
        "year",
        "series",
        "volume",
        "title",
        "paper_scheme_id",
        "status",
        "needs_confirmation",
        "uncertain_notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{4}-(I|II)$"
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "series": {
          "const": "national_new_gaokao"
        },
        "volume": {
          "enum": ["I", "II"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "paper_scheme_id": {
          "enum": [
            "new_gaokao_legacy",
            "new_gaokao_current"
          ]
        },
        "status": {
          "$ref": "common.schema.json#/$defs/status"
        },
        "needs_confirmation": {
          "type": "boolean"
        },
        "uncertain_notes": {
          "$ref": "common.schema.json#/$defs/notes"
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "number", "path"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{4}-(I|II)-[0-9]{2}$"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "path": {
            "type": "string",
            "pattern": "^items/[0-9]{2}\\.md$"
          }
        }
      }
    }
  }
}
