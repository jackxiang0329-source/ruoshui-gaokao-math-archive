{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gaokao_math_library/schemas/agent_config.schema.json",
  "title": "Agent Config",
  "type": "object",
  "required": ["id", "purpose", "stage", "must_read"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z_]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "data_cleaning",
        "surface_review",
        "descriptive_annotation"
      ]
    },
    "must_read": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
