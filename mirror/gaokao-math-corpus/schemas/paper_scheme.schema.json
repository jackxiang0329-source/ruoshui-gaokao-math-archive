{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gaokao_math_library/schemas/paper_scheme.schema.json",
  "title": "Paper Scheme",
  "type": "object",
  "required": [
    "id",
    "series",
    "title",
    "years",
    "volumes",
    "status",
    "total_items",
    "total_points",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "enum": ["new_gaokao_legacy", "new_gaokao_current"]
    },
    "series": {
      "const": "national_new_gaokao"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "years": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1900,
        "maximum": 2100
      },
      "uniqueItems": true
    },
    "volumes": {
      "type": "array",
      "items": {
        "enum": ["I", "II"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "enum": ["draft", "confirmed", "deprecated"]
    },
    "total_items": {
      "type": "integer",
      "minimum": 1
    },
    "total_points": {
      "type": "integer",
      "minimum": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "numbers", "points"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "$ref": "common.schema.json#/$defs/item_type"
          },
          "numbers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            },
            "uniqueItems": true
          },
          "points": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
