{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/gaokao_math_library/schemas/item.schema.json",
  "title": "Item Front Matter",
  "type": "object",
  "required": [
    "id",
    "paper_id",
    "number",
    "type",
    "status",
    "needs_confirmation",
    "uncertain_notes",
    "assets",
    "annotation"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-(I|II)-[0-9]{2}$"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[0-9]{4}-(I|II)$"
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "type": {
      "$ref": "common.schema.json#/$defs/item_type"
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": { "type": "string", "minLength": 1 },
        "B": { "type": "string", "minLength": 1 },
        "C": { "type": "string", "minLength": 1 },
        "D": { "type": "string", "minLength": 1 }
      }
    },
    "subquestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^\\([0-9]+\\)$"
          }
        }
      }
    },
    "status": {
      "$ref": "common.schema.json#/$defs/status"
    },
    "needs_confirmation": {
      "type": "boolean"
    },
    "uncertain_notes": {
      "$ref": "common.schema.json#/$defs/notes"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "annotation": {
      "$ref": "#/$defs/annotation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": ["mcq_single_answer", "mcq_multiple_answers"]
          }
        },
        "required": ["type"]
      },
      "then": {
        "required": ["options"]
      }
    }
  ],
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["id", "type", "path", "needs_confirmation", "notes"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(fig|table)-[0-9]{2}$"
        },
        "type": {
          "enum": ["figure", "table"]
        },
        "path": {
          "type": "string",
          "pattern": "^\\.\\./assets/[0-9]{2}-(fig|table)-[0-9]{2}\\.png$"
        },
        "needs_confirmation": {
          "type": "boolean"
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/notes"
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "status",
        "problem_kind",
        "primary_knowledge_point",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/annotation_status"
        },
        "problem_kind": {
          "type": ["string", "null"]
        },
        "primary_knowledge_point": {
          "type": ["string", "null"]
        },
        "notes": {
          "$ref": "common.schema.json#/$defs/notes"
        }
      }
    }
  }
}
